<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <meta name="turbo-visit-control" content="reload">
        <title>{% block title %}DSM{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
        <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.11/index.global.min.js"></script>
        {% block stylesheets %}{% endblock %}
        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body>
        <div id="main-wrapper">
            {% if app.user %}
            <!-- Navbar -->
            <aside>
                <strong id="nav_app_name">DSM - Driving School Manager</strong>
                <nav>
                    <ul>
                        {% if is_granted('ROLE_ADMIN') %}
                            <li><a href="{{ path('app_users') }}">Utilisateurs</a></li>
                        {% endif %}
                        <li><a href="{{ path('app_eleves') }}">Élèves</a></li>
                        <li><a href="{{ path('app_lecons') }}">Rendez-vous</a></li>
                        <li><a href="{{ path('app_moniteurs') }}">Moniteurs</a></li>
                        <li><a href="{{ path('app_vehicules') }}">Véhicules</a></li>
                        <li><a href="{{ path('app_statistiques') }}">Statistiques</a></li>
                    </ul>        
                    <a href="{{ path('app_logout') }}">Déconnexion</a>            
                </nav>
            </aside>
            {% endif %}
            <!-- Main -->
            <main>
                {% block body %}{% endblock %}
            </main>
        </div>

        <!-- Footer -->
        <footer>
            <a href="{{ path('app_mentions_legales') }}">Mentions légales</a>
            <span>© {{ "now"|date("Y") }}</span>
        </footer>

    </body>
</html>