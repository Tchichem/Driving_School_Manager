{% extends 'base.html.twig' %}
{% block title %}Modifier un élève{% endblock %}
{% block body %}

<h1>Modifier l'élève</h1>

{% for message in app.flashes('success') %}
    <div style="background:#efe; border:1px solid #cfc; padding:0.8rem; border-radius:4px; margin-bottom:1rem; color:#060;">
        {{ message }}
    </div>
{% endfor %}

<div class="form-wrapper">
    {{ form_start(form) }}
        {{ form_row(form.nom_eleve) }}
        {{ form_row(form.prenom_eleve) }}
        {{ form_row(form.date_naissance_eleve) }}
        {{ form_row(form.code) }}
        {{ form_row(form.conduite) }}
        <div style="display:flex; gap:1rem;">
            <button type="submit">Enregistrer</button>
            <a href="{{ path('app_eleves') }}" style="padding:0.5rem 1.4rem; background:#ccc; border:none; border-radius:4px; cursor:pointer; text-decoration:none; color:black;">Annuler</a>
        </div>
    {{ form_end(form) }}
</div>

{% endblock %}