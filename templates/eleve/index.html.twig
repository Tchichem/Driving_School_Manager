{% extends 'base.html.twig' %}

{% block title %}Elèves{% endblock %}

{% block body %}

<h1>Elèves</h1>

<h2>Effectuer une inscription</h2>
<div class="form-wrapper">
    {{ form_start(form) }}
        {{ form_row(form.nom_eleve) }}
        {{ form_row(form.prenom_eleve) }}
        {{ form_row(form.date_naissance_eleve) }}
        {{ form_row(form.code) }}
        {{ form_row(form.conduite) }}
        <button type="submit">Enregistrer</button>
    {{ form_end(form) }}
</div>

<form id="searchbar" method="get" action="{{ path('app_eleves') }}">
    Rechercher : <input type="text" name="search" value="{{ app.request.query.get('search') }}">
    <button type="submit">Entrer</button>
</form>
{% if eleves.getTotalItemCount() > 0 %}
    <div id="table-container">
        <table>
        {% set nextDir = direction == 'asc' ? 'desc' : 'asc' %}

        <thead>
            <tr>
                <th><a href="{{ path('app_eleves', {tri: 'id_eleve', sens: nextDir, search: search}) }}">ID {{ sort == 'id_eleve' ? (direction == 'asc' ? '↑' : '↓') : '↕' }}</a></th>
                <th><a href="{{ path('app_eleves', {tri: 'nom_eleve', sens: nextDir, search: search}) }}">Nom {{ sort == 'nom_eleve' ? (direction == 'asc' ? '↑' : '↓') : '↕' }}</a></th>
                <th><a href="{{ path('app_eleves', {tri: 'prenom_eleve', sens: nextDir, search: search}) }}">Prénom {{ sort == 'prenom_eleve' ? (direction == 'asc' ? '↑' : '↓') : '↕' }}</a></th>
                <th><a href="{{ path('app_eleves', {tri: 'date_naissance_eleve', sens: nextDir, search: search}) }}">Date de naissance {{ sort == 'date_naissance_eleve' ? (direction == 'asc' ? '↑' : '↓') : '↕' }}</a></th>
                <th><a href="{{ path('app_eleves', {tri: 'date_inscription', sens: nextDir, search: search}) }}">Date d'inscription {{ sort == 'date_inscription' ? (direction == 'asc' ? '↑' : '↓') : '↕' }}</a></th>
                <th>Code</th>
                <th>Conduite</th>
                {% if is_granted('ROLE_ADMIN') %}
                    <th>Actions</th>
                {% endif %}
            </tr>
        </thead>
            <tbody>
                {% for eleve in eleves %}
                <tr>
                    <td>{{ eleve.idEleve }}</td>
                    <td>{{ eleve.nomEleve }}</td>
                    <td>{{ eleve.prenomEleve }}</td>
                    <td>{{ eleve.dateNaissanceEleve|date('d/m/Y') }}</td>
                    <td>{{ eleve.dateInscription|date('d/m/Y') }}</td>
                    <td>
                        <form method="post" action="{{ path('app_eleves_update', {'id': eleve.idEleve}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('update_eleve') }}">
                            <input type="hidden" name="champ" value="code">
                            <input type="hidden" name="valeur" value="{{ eleve.code ? '0' : '1' }}">
                            <button type="submit">{{ eleve.code ? 'Obtenu' : 'Non obtenu' }}</button>
                        </form>
                    </td>
                    <td>
                        <form method="post" action="{{ path('app_eleves_update', {'id': eleve.idEleve}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('update_eleve') }}">
                            <input type="hidden" name="champ" value="conduite">
                            <input type="hidden" name="valeur" value="{{ eleve.conduite ? '0' : '1' }}">
                            <button type="submit" {{ not eleve.code ? 'disabled' : '' }}>
                                {{ eleve.conduite ? 'Obtenu' : 'Non obtenu' }}
                            </button>
                        </form>
                    </td>
                    {% if is_granted('ROLE_ADMIN') %}
                        <td>
                            <a href="{{ path('app_eleves_edit', {'id': eleve.idEleve}) }}"><button class="btn-update" type="submit">Modifier</button></a>
                            <form method="post" action="{{ path('app_eleves_delete', {'id': eleve.idEleve}) }}" style="display:inline;">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete_eleve_' ~ eleve.idEleve) }}">
                                <button class="btn-delete" type="submit" onclick="return confirm('Supprimer cet élève ?')">Supprimer</button>
                            </form>
                        </td>
                    {% endif %}
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    {{ knp_pagination_render(eleves) }}
{% else %}
    <p>Aucun élève n'est actuellement inscrit.</p>
{% endif %}
{% endblock %}