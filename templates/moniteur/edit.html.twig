{% extends 'base.html.twig' %}
{% block title %}Modifier un moniteur{% endblock %}
{% block body %}
<h1>Modifier le moniteur</h1>
<div class="form-wrapper">
    {{ form_start(form) }}
        {{ form_row(form.nom_moniteur) }}
        {{ form_row(form.prenom_moniteur) }}
        {{ form_row(form.date_naissance_moniteur) }}
        {{ form_row(form.date_embauche) }}
        {{ form_row(form.activite) }}
        <div style="display:flex; gap:1rem;">
            <button type="submit">Enregistrer</button>
            <a href="{{ path('app_moniteurs') }}" style="padding:0.5rem 1.4rem; background:#ccc; border:none; border-radius:4px; cursor:pointer; text-decoration:none; color:black;">Annuler</a>
        </div>
    {{ form_end(form) }}
</div>
{% endblock %}