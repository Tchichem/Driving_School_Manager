{% extends 'base.html.twig' %}
{% block title %}Rendez-vous{% endblock %}
{% block body %}

<h1>Rendez-vous</h1>

{% for message in app.flashes('error') %}
    <div style="background:#fee; border:1px solid #fcc; padding:0.8rem; border-radius:4px; margin-bottom:1rem; color:#900;">
        {{ message }}
    </div>
{% endfor %}

<!-- Calendrier -->
<div id="calendar" style="margin-bottom: 2rem;"></div>

<!-- Modal -->
<div id="modal" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.5); z-index:1000; align-items:center; justify-content:center;">
    <div style="background:white; padding:2rem; border-radius:8px; width:420px; max-width:90%;">
        <h2 style="margin-top:0;">Nouveau rendez-vous</h2>
        <form method="post" action="{{ path('app_lecons_create') }}">
            <input type="hidden" name="_token" value="{{ csrf_token('create_lecon') }}">
            <div style="margin-bottom:1rem;">
                <label style="display:block; font-weight:600; margin-bottom:0.3rem;">Date et heure</label>
                <input type="datetime-local" name="date_heure_display" id="modal-date-display" style="width:100%; padding:0.4rem 0.6rem; border:1px solid #ccc; border-radius:4px; box-sizing:border-box;">
            </div>
            <div style="margin-bottom:1rem;">
                <label style="display:block; font-weight:600; margin-bottom:0.3rem;">Élève</label>
                <select name="eleve_id" style="width:100%; padding:0.4rem 0.6rem; border:1px solid #ccc; border-radius:4px; box-sizing:border-box;">
                    {% for eleve in eleves %}
                        <option value="{{ eleve.idEleve }}">{{ eleve.nomEleve }} {{ eleve.prenomEleve }}</option>
                    {% endfor %}
                </select>
            </div>
            <div style="margin-bottom:1rem;">
                <label style="display:block; font-weight:600; margin-bottom:0.3rem;">Moniteur</label>
                <select name="moniteur_id" style="width:100%; padding:0.4rem 0.6rem; border:1px solid #ccc; border-radius:4px; box-sizing:border-box;">
                    {% for moniteur in moniteurs %}
                        <option value="{{ moniteur.idMoniteur }}">{{ moniteur.nomMoniteur }} {{ moniteur.prenomMoniteur }}</option>
                    {% endfor %}
                </select>
            </div>
            <div style="margin-bottom:1rem;">
                <label style="display:block; font-weight:600; margin-bottom:0.3rem;">Véhicule</label>
                <select name="modele_id" style="width:100%; padding:0.4rem 0.6rem; border:1px solid #ccc; border-radius:4px; box-sizing:border-box;">
                    {% for modele in modeles %}
                        <option value="{{ modele.modeleVehic }}">{{ modele.modeleVehic }}</option>
                    {% endfor %}
                </select>
            </div>
            <div style="margin-bottom:1rem;">
                <label style="display:block; font-weight:600; margin-bottom:0.3rem;">Durée</label>
                <select name="duree" style="width:100%; padding:0.4rem 0.6rem; border:1px solid #ccc; border-radius:4px; box-sizing:border-box;">
                    <option value="30">30 minutes</option>
                    <option value="60">60 minutes</option>
                    <option value="90">90 minutes</option>
                    <option value="120">120 minutes</option>
                </select>
            </div>
            <div style="display:flex; gap:1rem;">
                <button type="submit" style="padding:0.5rem 1.4rem; background:#000; color:white; border:none; border-radius:4px; cursor:pointer;">Enregistrer</button>
                <button type="button" onclick="closeModal()" style="padding:0.5rem 1.4rem; background:#ccc; border:none; border-radius:4px; cursor:pointer;">Annuler</button>
            </div>
        </form>
    </div>
</div>

<!-- Recherche et liste -->
<form id="searchbar" method="get" action="{{ path('app_lecons') }}">
    Rechercher : <input type="text" name="search" value="{{ app.request.query.get('search') }}">
    <button type="submit">Entrer</button>
</form>

{% if lecons.getTotalItemCount() > 0 %}
    <div id="table-container">
        <table>
            {% set nextDir = direction == 'asc' ? 'desc' : 'asc' %}
            <thead>
                <tr>
                    <th>Élève</th>
                    <th>Moniteur</th>
                    <th>Véhicule</th>
                    <th><a href="...">Durée ...</a></th>
                    <th><a href="...">Horaire ...</a></th>
                    {% if is_granted('ROLE_ADMIN') %}<th>Actions</th>{% endif %}
                </tr>
            </thead>
            <tbody>
            {% for lecon in lecons %}
            <tr>
                <td>{{ lecon.leconEleveId.nomEleve }} {{ lecon.leconEleveId.prenomEleve }}</td>
                <td>{{ lecon.leconMoniteurId.nomMoniteur }} {{ lecon.leconMoniteurId.prenomMoniteur }}</td>
                <td>{{ lecon.leconModeleVehic.modeleVehic }}</td>
                <td>{{ lecon.duree }} min</td>
                <td>{{ lecon.leconDateHeureRaw }}</td>
                {% if is_granted('ROLE_ADMIN') %}
                <td>
                    <form method="post" action="{{ path('app_lecons_delete', {'id': lecon.idLecon}) }}" style="display:inline;">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete_lecon_' ~ lecon.idLecon) }}">
                        <button class="btn-delete" type="submit" onclick="return confirm('Supprimer ce rendez-vous ?')">Supprimer</button>
                    </form>
                </td>
                {% endif %}
            </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
    {{ knp_pagination_render(lecons) }}
{% else %}
    <p>Aucune leçon n'est actuellement enregistrée.</p>
{% endif %}

<script>
    document.addEventListener('turbo:load', function() {
        var calendarEl = document.getElementById('calendar');
        if (!calendarEl) return;
        
        calendar = new FullCalendar.Calendar(calendarEl, {
            initialView: 'timeGridWeek',
            locale: 'fr',
            slotMinTime: '08:00:00',
            slotMaxTime: '19:00:00',
            eventColor: '#3d3d3d',
            eventTextColor: '#ffffff',
            hiddenDays: [0],
            headerToolbar: {
                left: 'prev,next today',
                center: 'title',
                right: 'dayGridMonth,timeGridWeek,timeGridDay'
            },
            events: '{{ path('app_lecons_events') }}',
            selectable: true,
            select: function(info) {
                openModal(info.startStr);
            }
        });
        calendar.render();
    });



    function openModal(dateStr) {
        var d = new Date(dateStr);
        var formatted = d.getFullYear() + '-' +
            String(d.getMonth()+1).padStart(2,'0') + '-' +
            String(d.getDate()).padStart(2,'0') + 'T' +
            String(d.getHours()).padStart(2,'0') + ':' +
            String(d.getMinutes()).padStart(2,'0');
        document.getElementById('modal-date-display').value = formatted;
        document.getElementById('modal').style.display = 'flex';
    }

    function closeModal() {
        document.getElementById('modal').style.display = 'none';
    }
</script>

{% endblock %}