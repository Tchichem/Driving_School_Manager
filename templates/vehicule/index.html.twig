{% extends 'base.html.twig' %}
{% block title %}Véhicules{% endblock %}
{% block body %}

<h1>Véhicules & Modèles</h1>

<h2>Enregistrer un nouveau véhicule</h2>
<div class="form-wrapper">
    {{ form_start(formVehicule) }}
        {{ form_row(formVehicule.num_immatric) }}
        {{ form_row(formVehicule.modele_vehic) }}
        {{ form_row(formVehicule.etat) }}
        <button type="submit">Enregistrer</button>
    {{ form_end(formVehicule) }}
</div>

<h2>Véhicules</h2>
<form id="searchbar" method="get" action="{{ path('app_vehicules') }}">
    Rechercher : <input type="text" name="search_vehicule" value="{{ app.request.query.get('search_vehicule') }}">
    <button type="submit">Entrer</button>
</form>

{% if vehicules.getTotalItemCount() > 0 %}
    <div id="table-container">
        <table>
            {% set nextDirV = directionVehicule == 'asc' ? 'desc' : 'asc' %}
            <thead>
                <tr>
                    <th><a href="{{ path('app_vehicules', {tri_vehicule: 'num_immatric', sens_vehicule: nextDirV, search_vehicule: searchVehicule}) }}">Numéro d'immatriculation {{ sortVehicule == 'num_immatric' ? (directionVehicule == 'asc' ? '↑' : '↓') : '↕' }}</a></th>
                    <th>Modèle</th>
                    <th>État</th>
                    {% if is_granted('ROLE_ADMIN') %}<th>Actions</th>{% endif %}
                </tr>
            </thead>
            <tbody>
                {% for vehicule in vehicules %}
                <tr>
                    <td>{{ vehicule.numImmatric }}</td>
                    <td>{{ vehicule.modeleVehic.modeleVehic }}</td>
                    <td>
                        <form method="post" action="{{ path('app_vehicules_update', {'id': vehicule.numImmatric}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('update_vehicule') }}">
                            <input type="hidden" name="valeur" value="{{ vehicule.etat ? '0' : '1' }}">
                            <button type="submit">{{ vehicule.etat ? 'En service' : 'Hors service' }}</button>
                        </form>
                    </td>
                    {% if is_granted('ROLE_ADMIN') %}
                        <td>
                            <a href="{{ path('app_vehicules_edit', {'id': vehicule.numImmatric}) }}"><button class="btn-update" type="submit">Modifier</button></a>
                            <form method="post" action="{{ path('app_vehicules_delete', {'id': vehicule.numImmatric}) }}" style="display:inline;">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete_vehicule_' ~ vehicule.numImmatric) }}">
                                <button class="btn-delete" type="submit" onclick="return confirm('Supprimer ce véhicule ?')">Supprimer</button>
                            </form>
                        </td>
                    {% endif %}
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    {{ knp_pagination_render(vehicules) }}
{% else %}
    <p>Aucun véhicule n'est actuellement enregistré.</p>
{% endif %}

<hr>

<h2>Enregistrer un nouveau modèle</h2>
<div class="form-wrapper">
    {{ form_start(formModele) }}
        {{ form_row(formModele.modele_vehic) }}
        {{ form_row(formModele.marque) }}
        {{ form_row(formModele.annee) }}
        {{ form_row(formModele.date_achat) }}
        <button type="submit">Enregistrer</button>
    {{ form_end(formModele) }}
</div>

<h2>Modèles</h2>
<form id="searchbar" method="get" action="{{ path('app_vehicules') }}">
    Rechercher : <input type="text" name="search_modele" value="{{ app.request.query.get('search_modele') }}">
    <button type="submit">Entrer</button>
</form>

{% if modeles.getTotalItemCount() > 0 %}
    <div id="table-container">
        <table>
            {% set nextDirM = directionModele == 'asc' ? 'desc' : 'asc' %}
            <thead>
                <tr>
                    <th><a href="{{ path('app_vehicules', {tri_modele: 'modele_vehic', sens_modele: nextDirM, search_modele: searchModele}) }}">Nom du modèle {{ sortModele == 'modele_vehic' ? (directionModele == 'asc' ? '↑' : '↓') : '↕' }}</a></th>
                    <th><a href="{{ path('app_vehicules', {tri_modele: 'marque', sens_modele: nextDirM, search_modele: searchModele}) }}">Marque {{ sortModele == 'marque' ? (directionModele == 'asc' ? '↑' : '↓') : '↕' }}</a></th>
                    <th><a href="{{ path('app_vehicules', {tri_modele: 'annee', sens_modele: nextDirM, search_modele: searchModele}) }}">Année {{ sortModele == 'annee' ? (directionModele == 'asc' ? '↑' : '↓') : '↕' }}</a></th>
                    <th><a href="{{ path('app_vehicules', {tri_modele: 'date_achat', sens_modele: nextDirM, search_modele: searchModele}) }}">Date d'achat {{ sortModele == 'date_achat' ? (directionModele == 'asc' ? '↑' : '↓') : '↕' }}</a></th>
                    {% if is_granted('ROLE_ADMIN') %}<th>Actions</th>{% endif %}
                </tr>
            </thead>
            <tbody>
                {% for modele in modeles %}
                <tr>
                    <td>{{ modele.modeleVehic }}</td>
                    <td>{{ modele.marque }}</td>
                    <td>{{ modele.annee }}</td>
                    <td>{{ modele.dateAchat|date('d/m/Y') }}</td>
                    {% if is_granted('ROLE_ADMIN') %}
                        <td>
                            <a href="{{ path('app_modeles_edit', {'id': modele.modeleVehic}) }}"><button id="btn-update" type="submit">Modifier</button></a>
                            <form method="post" action="{{ path('app_modeles_delete', {'id': modele.modeleVehic}) }}" style="display:inline;">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete_modele_' ~ modele.modeleVehic) }}">
                                <button id="btn-delete" type="submit" onclick="return confirm('Supprimer ce modèle ?')">Supprimer</button>
                            </form>
                        </td>
                    {% endif %}
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    {{ knp_pagination_render(modeles) }}
{% else %}
    <p>Aucun modèle n'est actuellement enregistré.</p>
{% endif %}

{% endblock %}